    "handoffObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "schemaVersion",
        "projectId",
        "featureKey",
        "backlog",
        "storyKeys",
        "milestone",
        "authority",
        "observedAt",
