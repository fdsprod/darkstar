      "sourceIssues": ["DAR-9", "DAR-14"],
      "controls": ["DS-075", "DS-080", "DS-099", "DS-200"],
      "reviewTriggers": ["processor version change", "provider compatibility change", "security advisory"],
      "lifecycle": {"state": "open"}
    },
    {
