  "kind": "RiskRegister",
  "risks": [
    {
      "id": "RSK-001",
      "title": "Adversarial evidence influences provider behavior",
      "severity": "critical",
      "owner": "authorization-capability-security",
      "statement": "Prompt injection cannot be perfectly detected and may influence a provider despite evidence boundaries.",
      "affectedDecisions": ["DS-005", "DS-006", "DS-007", "DS-010"],
      "sourceIssues": ["DAR-14"],
      "controls": ["DS-192", "DS-193", "DS-199", "DS-200"],
      "reviewTriggers": ["provider permission change", "new evidence format", "new inherited capability"],
      "lifecycle": {"state": "open"}
    },
    {
      "id": "RSK-002",
      "title": "Sensitive values survive redaction",
      "severity": "critical",
      "owner": "data-protection",
      "statement": "Structural redaction may miss an encoded or transformed credential copied into context, logs, or exports.",
      "affectedDecisions": ["DS-006", "DS-008", "DS-010"],
      "sourceIssues": ["DAR-14"],
      "controls": ["DS-040", "DS-193", "DS-199", "DS-200"],
      "reviewTriggers": ["new credential source", "new export surface", "redaction test failure"],
      "lifecycle": {"state": "open"}
    },
    {
