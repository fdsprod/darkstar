{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkstar.local/schemas/workflow-v1alpha1.schema.json",
  "title": "DARKSTAR workflow v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "darkstar.local/v1alpha1"},
    "kind": {"const": "Workflow"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "valueType": {
      "enum": ["null", "boolean", "integer", "number", "string", "array", "object"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "displayName": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeDefaults", "nodes"],
      "properties": {
        "inputs": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/valueDeclaration"},
          "default": {}
        },
        "routeDefaults": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry", "terminals"],
          "properties": {
            "entry": {"$ref": "#/$defs/identifier"},
            "terminals": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/identifier"}
            }
          }
        },
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/node"}
        }
      }
    },
    "valueDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"$ref": "#/$defs/valueType"},
        "schema": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "type"],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^(run\\.input\\.[a-z][a-z0-9_]{0,63}|node\\.[a-z][a-z0-9_]{0,63}\\.output\\.[a-z][a-z0-9_]{0,63})$"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(|/(?:[^~/]|~[01])*)?(?:/(?:[^~/]|~[01])*)*$"
        },
        "type": {"$ref": "#/$defs/valueType"},
        "required": {"type": "boolean", "default": true},
        "default": true,
        "description": {"type": "string"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"required": {"const": false}},
            "required": ["required"]
          },
          "else": {"not": {"required": ["default"]}}
        }
      ]
    },
    "outputDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"$ref": "#/$defs/valueType"},
        "schema": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "required": {"type": "boolean", "default": true}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "on"],
      "properties": {
        "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 100},
        "on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "provider_unavailable",
              "provider_rate_limit",
              "process_failure",
              "validator_failure",
              "timeout",
              "interrupted"
            ]
          }
        }
      }
    },
    "checkpoint": {
      "oneOf": [
        {"enum": ["none", "acknowledge", "approve"]},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "none"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "acknowledge"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"const": "approve"},
            "maxRevisions": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "when"],
          "properties": {
            "mode": {"const": "approve_on_change"},
            "when": {"$ref": "#/$defs/predicate"},
            "maxRevisions": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "externalCondition"],
          "properties": {
            "mode": {"const": "external"},
            "externalCondition": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "from"],
      "properties": {
        "mode": {"enum": ["one", "all"]},
        "from": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "reasoningExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent"],
      "properties": {
        "agent": {"type": "string", "minLength": 1},
        "skills": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "gateExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "condition"],
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "condition": {"$ref": "#/$defs/predicate"}
      }
    },
    "commandExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "cwd": {"type": "string"},
        "timeoutSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "approvalExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor"],
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "externalCondition": {"type": "string", "minLength": 1},
        "evidenceOutput": {"$ref": "#/$defs/identifier"}
      },
      "allOf": [
        {
          "if": {"properties": {"actor": {"const": "external"}}, "required": ["actor"]},
          "then": {"required": ["externalCondition", "evidenceOutput"]},
          "else": {"not": {"anyOf": [{"required": ["externalCondition"]}, {"required": ["evidenceOutput"]}]}}
        }
      ]
    },
    "workflowRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "subworkflowCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "entry", "terminals", "inputs", "outputs"],
      "properties": {
        "workflow": {"$ref": "#/$defs/workflowRef"},
        "entry": {"$ref": "#/$defs/identifier"},
        "terminals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "inputs": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/identifier"}
        },
        "outputs": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {
            "type": "string",
            "pattern": "^node\\.[a-z][a-z0-9_]{0,63}\\.output\\.[a-z][a-z0-9_]{0,63}$"
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendedEvidence", "policyGates", "invariants", "remedies"],
      "properties": {
        "recommendedEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "description"],
            "properties": {
              "role": {"$ref": "#/$defs/identifier"},
              "description": {"type": "string", "minLength": 1}
            }
          }
        },
        "policyGates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["policy", "enforcement", "description"],
            "properties": {
              "policy": {"$ref": "#/$defs/identifier"},
              "enforcement": {"enum": ["advisory", "blocking", "external"]},
              "description": {"type": "string", "minLength": 1}
            }
          }
        },
        "invariants": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "remedies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "target", "action", "description"],
            "properties": {
              "code": {"$ref": "#/$defs/identifier"},
              "target": {"$ref": "#/$defs/identifier"},
              "action": {"enum": ["supply_input", "revise_artifact", "clarify_decision", "install_capability", "rerun_validation"]},
              "description": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "entry", "terminal", "inputs", "outputs"],
      "properties": {
        "displayName": {"type": "string", "minLength": 1},
        "type": {"enum": ["reasoning", "gate", "command", "approval", "subworkflow"]},
        "entry": {"type": "boolean"},
        "terminal": {"type": "boolean"},
        "inputs": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/binding"}
        },
        "outputs": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/outputDeclaration"}
        },
        "readiness": {"$ref": "#/$defs/readiness"},
        "reasoning": {"$ref": "#/$defs/reasoningExecutor"},
        "gate": {"$ref": "#/$defs/gateExecutor"},
        "command": {"$ref": "#/$defs/commandExecutor"},
        "approval": {"$ref": "#/$defs/approvalExecutor"},
        "call": {"$ref": "#/$defs/subworkflowCall"},
        "validators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "output": {"$ref": "#/$defs/identifier"},
              "schema": {"type": "string", "minLength": 1},
              "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            },
            "oneOf": [
              {"required": ["output", "schema"]},
              {"required": ["command"]}
            ]
          },
          "default": []
        },
        "retry": {"$ref": "#/$defs/retry"},
        "checkpoint": {"$ref": "#/$defs/checkpoint"},
        "transitionMode": {"enum": ["exclusive", "fanout"], "default": "exclusive"},
        "join": {"$ref": "#/$defs/join"},
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"},
          "default": []
        },
        "transitions": {
          "type": "array",
          "items": {"$ref": "#/$defs/transition"},
          "default": []
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {"const": "reasoning"},
            "reasoning": {"$ref": "#/$defs/reasoningExecutor"}
          },
          "required": ["reasoning"],
          "not": {"anyOf": [{"required": ["gate"]}, {"required": ["command"]}, {"required": ["approval"]}, {"required": ["call"]}]}
        },
        {
          "properties": {
            "type": {"const": "gate"},
            "gate": {"$ref": "#/$defs/gateExecutor"}
          },
          "required": ["gate"],
          "not": {"anyOf": [{"required": ["reasoning"]}, {"required": ["command"]}, {"required": ["approval"]}, {"required": ["call"]}]}
        },
        {
          "properties": {
            "type": {"const": "command"},
            "command": {"$ref": "#/$defs/commandExecutor"}
          },
          "required": ["command"],
          "not": {"anyOf": [{"required": ["reasoning"]}, {"required": ["gate"]}, {"required": ["approval"]}, {"required": ["call"]}]}
        },
        {
          "properties": {
            "type": {"const": "approval"},
            "approval": {"$ref": "#/$defs/approvalExecutor"}
          },
          "required": ["approval"],
          "not": {"anyOf": [{"required": ["reasoning"]}, {"required": ["gate"]}, {"required": ["command"]}, {"required": ["call"]}]}
        },
        {
          "properties": {
            "type": {"const": "subworkflow"},
            "call": {"$ref": "#/$defs/subworkflowCall"}
          },
          "required": ["call"],
          "not": {"anyOf": [{"required": ["reasoning"]}, {"required": ["gate"]}, {"required": ["command"]}, {"required": ["approval"]}]}
        }
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "to"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "to": {"$ref": "#/$defs/identifier"},
        "when": {"$ref": "#/$defs/predicate"},
        "kind": {"enum": ["normal", "bounded"], "default": "normal"},
        "maxTraversals": {"type": "integer", "minimum": 1, "maximum": 10000},
        "enabledByDefault": {"type": "boolean", "default": true}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "bounded"}}, "required": ["kind"]},
          "then": {"required": ["maxTraversals"]},
          "else": {"not": {"required": ["maxTraversals"]}}
        }
      ]
    },
    "referenceOperand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^(output\\.[a-z][a-z0-9_]{0,63}|input\\.[a-z][a-z0-9_]{0,63}|run\\.input\\.[a-z][a-z0-9_]{0,63})(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*$"
        }
      }
    },
    "literalOperand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["literal"],
      "properties": {"literal": true}
    },
    "operand": {
      "oneOf": [
        {"$ref": "#/$defs/referenceOperand"},
        {"$ref": "#/$defs/literalOperand"}
      ]
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["const"],
          "properties": {"const": {"type": "boolean"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "args"],
          "properties": {
            "op": {"enum": ["eq", "ne", "lt", "lte", "gt", "gte"]},
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"$ref": "#/$defs/operand"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "arg"],
          "properties": {
            "op": {"const": "present"},
            "arg": {"$ref": "#/$defs/referenceOperand"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "args"],
          "properties": {
            "op": {"enum": ["all", "any"]},
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/predicate"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "arg"],
          "properties": {
            "op": {"const": "not"},
            "arg": {"$ref": "#/$defs/predicate"}
          }
        }
      ]
    }
  }
}
