{
  "openapi": "3.1.0",
  "info": {"title":"DARKSTAR local API","version":"1.0.0-alpha.1"},
  "servers": [{"url":"http://127.0.0.1:{port}","variables":{"port":{"default":"0"}}}],
  "security": [{"bearerAuth":[]}],
  "paths": {
    "/api/v1/health": {
      "get": {"operationId":"getHealth","security":[],"responses":{"200":{"description":"Daemon process health and supported API versions","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Health"}}}}}}
    },
    "/api/v1/": {
      "get": {"operationId":"getApiRoot","responses":{"200":{"description":"Negotiated API root","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiRoot"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/doctor": {
      "get": {"operationId":"getDoctorReport","parameters":[{"name":"projectRoot","in":"query","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Detailed subsystem readiness report","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DoctorReport"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/runs": {
      "get": {"operationId":"listRuns","parameters":[{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/After"}],"responses":{"200":{"description":"Run page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunPage"}}}},"default":{"$ref":"#/components/responses/Error"}}},
      "post": {"operationId":"createOrStartRun","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/CreateRunRequest"},{"$ref":"#/components/schemas/StartFakeRunRequest"}]}}}},"responses":{"201":{"description":"Run created from an installed workflow","headers":{"ETag":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Run"}}}},"202":{"description":"Scenario-backed run and provider attempt durably created","headers":{"Location":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunView"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/runs/{runId}": {
      "get": {"operationId":"getRun","parameters":[{"$ref":"#/components/parameters/RunId"}],"responses":{"200":{"description":"Persisted run and provider attempts","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunView"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/runs/{runId}/export": {
      "get": {"operationId":"exportRun","parameters":[{"$ref":"#/components/parameters/RunId"}],"responses":{"200":{"description":"Default-redacted, self-contained run evidence bundle","headers":{"Content-Disposition":{"schema":{"type":"string"}},"X-Darkstar-Export-Schema":{"schema":{"const":"1"}}},"content":{"application/zip":{"schema":{"type":"string","format":"binary"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/runs/{runId}/cancel": {
      "post": {"operationId":"cancelRun","parameters":[{"$ref":"#/components/parameters/RunId"},{"$ref":"#/components/parameters/IdempotencyKey"},{"$ref":"#/components/parameters/IfMatch"}],"responses":{"200":{"description":"Run cancelled","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Run"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/approvals/{approvalId}/decisions": {
      "post": {"operationId":"decideApproval","parameters":[{"name":"approvalId","in":"path","required":true,"schema":{"type":"string"}},{"$ref":"#/components/parameters/IdempotencyKey"},{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["action","scopeDigest","policyDigest"],"properties":{"action":{"enum":["approve","acknowledge","request_changes","reject","satisfy_external","deny","allow_once","allow_for_session","cancel","expire"]},"scopeDigest":{"type":"string"},"policyDigest":{"type":"string"}}}}}},"responses":{"200":{"description":"Decision recorded","content":{"application/json":{"schema":{"type":"object"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/events": {
      "get": {"operationId":"streamEvents","parameters":[{"name":"Last-Event-ID","in":"header","required":false,"schema":{"type":"integer","minimum":0}}],"responses":{"200":{"description":"Ordered domain events","content":{"text/event-stream":{"schema":{"type":"string"}}}},"410":{"description":"Replay position unavailable","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/logs/{reference}": {
      "get": {"operationId":"readLog","parameters":[{"$ref":"#/components/parameters/LogReference"},{"$ref":"#/components/parameters/LogAfter"},{"$ref":"#/components/parameters/LogLimit"}],"responses":{"200":{"description":"Bounded log bytes","headers":{"X-Darkstar-Log-Offset":{"schema":{"type":"integer","minimum":0}},"X-Darkstar-Log-Next-Offset":{"schema":{"type":"integer","minimum":0}},"X-Darkstar-Log-Size":{"schema":{"type":"integer","minimum":0}},"X-Darkstar-Log-Complete":{"schema":{"type":"boolean"}}},"content":{"application/octet-stream":{"schema":{"type":"string","format":"binary"}}}},"416":{"description":"Log cursor is beyond the current size","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/workflows": {
      "get": {"operationId":"listWorkflows","parameters":[{"$ref":"#/components/parameters/OptionalWorkflowName"}],"responses":{"200":{"description":"Installed immutable workflow versions","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/WorkflowVersionSummary"}}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/workflows/validate": {
      "post": {"operationId":"validateWorkflow","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowCandidateRequest"}}}},"responses":{"200":{"description":"Complete ordered workflow validation report","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowValidationReport"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/workflows/install": {
      "post": {"operationId":"installWorkflow","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowCandidateRequest"}}}},"responses":{"201":{"description":"Immutable workflow version installed or already present","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowInstallResult"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/workflows/show": {
      "get": {"operationId":"showWorkflow","parameters":[{"$ref":"#/components/parameters/WorkflowName"},{"$ref":"#/components/parameters/OptionalWorkflowVersion"}],"responses":{"200":{"description":"Installed typed workflow definition","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowDefinition"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/workflows/graph": {
      "get": {"operationId":"graphWorkflow","parameters":[{"$ref":"#/components/parameters/WorkflowName"},{"$ref":"#/components/parameters/OptionalWorkflowVersion"}],"responses":{"200":{"description":"Stable authored node and edge projection","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowGraph"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/workflows/preview": {
      "post": {"operationId":"previewWorkflowRoute","parameters":[{"$ref":"#/components/parameters/WorkflowName"},{"$ref":"#/components/parameters/OptionalWorkflowVersion"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowPreviewRequest"}}}},"responses":{"200":{"description":"Candidate frozen route projection","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowRoutePreview"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/artifacts": {
      "get": {"operationId":"listArtifacts","parameters":[{"name":"targetKind","in":"query","schema":{"$ref":"#/components/schemas/ArtifactTargetKind"}},{"name":"targetId","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"Latest artifacts, optionally restricted to an exact attachment target","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ArtifactView"}}}}},"default":{"$ref":"#/components/responses/Error"}}},
      "post": {"operationId":"ingestArtifact","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactIngestRequest"}}}},"responses":{"201":{"description":"Immutable artifact version stored","headers":{"Location":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactIngestResult"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/artifacts/{artifactId}": {
      "get": {"operationId":"getArtifact","parameters":[{"$ref":"#/components/parameters/ArtifactId"},{"$ref":"#/components/parameters/OptionalArtifactVersion"}],"responses":{"200":{"description":"Exact or latest artifact view","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactView"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/artifacts/{artifactId}/revisions": {
      "post": {"operationId":"reviseArtifact","parameters":[{"$ref":"#/components/parameters/ArtifactId"},{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactIngestRequest"}}}},"responses":{"201":{"description":"New immutable artifact version stored","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactIngestResult"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/artifacts/{artifactId}/diff": {
      "get": {"operationId":"diffArtifactVersions","parameters":[{"$ref":"#/components/parameters/ArtifactId"},{"$ref":"#/components/parameters/FromArtifactVersion"},{"$ref":"#/components/parameters/ToArtifactVersion"}],"responses":{"200":{"description":"Metadata and representation differences between exact versions","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactVersionDiff"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/artifacts/{artifactId}/extract": {
      "post": {"operationId":"extractArtifact","parameters":[{"$ref":"#/components/parameters/ArtifactId"},{"$ref":"#/components/parameters/ArtifactVersion"},{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"Derived representations","content":{"application/json":{"schema":{"type":"object"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/artifacts/{artifactId}/lint": {
      "get": {"operationId":"lintArtifact","parameters":[{"$ref":"#/components/parameters/ArtifactId"},{"$ref":"#/components/parameters/ArtifactVersion"}],"responses":{"200":{"description":"Artifact validation findings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactLintResult"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/artifacts/{artifactId}/representations": {
      "get": {"operationId":"listArtifactRepresentations","parameters":[{"$ref":"#/components/parameters/ArtifactId"},{"$ref":"#/components/parameters/ArtifactVersion"}],"responses":{"200":{"description":"Derived representations for an exact artifact version","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ArtifactRepresentation"}}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/artifacts/{artifactId}/impact": {
      "post": {"operationId":"assessArtifactImpact","parameters":[{"$ref":"#/components/parameters/ArtifactId"},{"$ref":"#/components/parameters/ArtifactVersion"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactImpactRequest"}}}},"responses":{"200":{"description":"Late-evidence impact assessment","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactImpactAssessment"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/artifact-bindings": {
      "post": {"operationId":"attachArtifact","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactAttachRequest"}}}},"responses":{"201":{"description":"Artifact attached to an exact target","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactBinding"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/artifact-bindings/{bindingId}": {
      "delete": {"operationId":"detachArtifact","parameters":[{"name":"bindingId","in":"path","required":true,"schema":{"type":"string"}},{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"Artifact attachment deactivated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactBinding"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    }
  },
  "components": {
    "securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer"}},
    "parameters": {
      "RunId":{"name":"runId","in":"path","required":true,"schema":{"type":"string"}},
      "Limit":{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200,"default":50}},
      "After":{"name":"after","in":"query","required":false,"schema":{"type":"string"}},
      "LogReference":{"name":"reference","in":"path","required":true,"schema":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}},
      "LogAfter":{"name":"after","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0}},
      "LogLimit":{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":1048576,"default":65536}},
      "ArtifactId":{"name":"artifactId","in":"path","required":true,"schema":{"type":"string","pattern":"^artifact_"}},
      "ArtifactVersion":{"name":"version","in":"query","required":true,"schema":{"type":"integer","minimum":1}},
      "OptionalArtifactVersion":{"name":"version","in":"query","required":false,"schema":{"type":"integer","minimum":1}},
      "FromArtifactVersion":{"name":"from","in":"query","required":true,"schema":{"type":"integer","minimum":1}},
      "ToArtifactVersion":{"name":"to","in":"query","required":true,"schema":{"type":"integer","minimum":1}},
      "WorkflowName":{"name":"name","in":"query","required":true,"schema":{"type":"string","pattern":"^[a-z][a-z0-9._/-]{0,127}$"}},
      "OptionalWorkflowName":{"name":"name","in":"query","required":false,"schema":{"type":"string","pattern":"^[a-z][a-z0-9._/-]{0,127}$"}},
      "OptionalWorkflowVersion":{"name":"version","in":"query","required":false,"schema":{"type":"string"}},
      "IdempotencyKey":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":128}},
      "IfMatch":{"name":"If-Match","in":"header","required":true,"schema":{"type":"string"}}
    },
    "responses":{"Error":{"description":"Stable API error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}},
    "schemas": {
      "ApiError":{"$ref":"./api-error-v1alpha1.schema.json"},
      "RecoveryStatus":{"type":"object","additionalProperties":false,"required":["reconciled","reconcileRequired"],"properties":{"reconciled":{"type":"integer","minimum":0},"reconcileRequired":{"type":"integer","minimum":0}}},
      "Health":{"type":"object","additionalProperties":false,"required":["schemaVersion","status","apiVersions"],"properties":{"schemaVersion":{"const":1},"status":{"const":"ok"},"apiVersions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["v1"]}},"recovery":{"$ref":"#/components/schemas/RecoveryStatus"}}},
      "ApiRoot":{"type":"object","additionalProperties":false,"required":["schemaVersion","apiVersion"],"properties":{"schemaVersion":{"const":1},"apiVersion":{"const":"v1"},"recovery":{"$ref":"#/components/schemas/RecoveryStatus"}}},
      "DoctorReport":{"$ref":"./health-report-v1alpha1.schema.json"},
      "WorkflowDocument":{"$ref":"./workflow-v1alpha1.schema.json"},
      "WorkflowVersionSummary":{"type":"object","additionalProperties":false,"required":["name","version","digest","sourceScope","sourceReference","installedAt"],"properties":{"name":{"type":"string"},"version":{"type":"string"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"sourceScope":{"enum":["default","user","project"]},"sourceReference":{"type":"string"},"installedAt":{"type":"string","format":"date-time"}}},
      "WorkflowCandidateRequest":{"type":"object","additionalProperties":false,"required":["document","sourceScope","sourceReference"],"properties":{"document":{"$ref":"#/components/schemas/WorkflowDocument"},"sourceScope":{"enum":["default","user","project"]},"sourceReference":{"type":"string","minLength":1}}},
      "WorkflowValidationIssue":{"type":"object","additionalProperties":false,"required":["code","message"],"properties":{"code":{"type":"string"},"message":{"type":"string"},"location":{"type":"string"},"details":{"type":"object","additionalProperties":{"type":"array","items":{"type":"string"}}}}},
      "WorkflowValidationReport":{"type":"object","additionalProperties":false,"required":["issues"],"properties":{"metadata":{"type":"object","additionalProperties":false,"required":["name","version"],"properties":{"name":{"type":"string"},"version":{"type":"string"},"displayName":{"type":"string"},"description":{"type":"string"}}},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"issues":{"type":"array","items":{"$ref":"#/components/schemas/WorkflowValidationIssue"}}}},
      "WorkflowInstallResult":{"type":"object","additionalProperties":false,"required":["version","disposition"],"properties":{"version":{"$ref":"#/components/schemas/WorkflowVersionSummary"},"disposition":{"enum":["created","already_installed"]}}},
      "WorkflowDefinition":{"type":"object","additionalProperties":false,"required":["version","document"],"properties":{"version":{"$ref":"#/components/schemas/WorkflowVersionSummary"},"document":{"$ref":"#/components/schemas/WorkflowDocument"}}},
      "WorkflowIdentity":{"type":"object","additionalProperties":false,"required":["name","version","digest"],"properties":{"name":{"type":"string"},"version":{"type":"string"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
      "WorkflowGraph":{"type":"object","additionalProperties":false,"required":["workflow","nodes","edges"],"properties":{"workflow":{"$ref":"#/components/schemas/WorkflowIdentity"},"nodes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","type"],"properties":{"id":{"type":"string"},"type":{"enum":["reasoning","gate","command","approval","subworkflow"]},"entry":{"type":"boolean"},"terminal":{"type":"boolean"}}}},"edges":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","from","to"],"properties":{"id":{"type":"string"},"from":{"type":"string"},"to":{"type":"string"}}}}}},
      "WorkflowPreviewRequest":{"type":"object","additionalProperties":false,"required":["range","context"],"properties":{"range":{"type":"object","additionalProperties":false,"properties":{"from":{"type":"string"},"until":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},"context":{"type":"object","additionalProperties":false,"properties":{"runInputs":{"type":"object"},"acceptedOutputs":{"type":"object"},"requiredNodes":{"type":"array","items":{"type":"string"},"uniqueItems":true}}}}},
      "WorkflowRoutePreview":{"type":"object","additionalProperties":false,"required":["workflow","route"],"properties":{"workflow":{"$ref":"#/components/schemas/WorkflowIdentity"},"route":{"type":"object","additionalProperties":false,"required":["entry","terminals","nodes","transitions","excludedNodes","inputRequirements"],"properties":{"entry":{"type":"string"},"terminals":{"type":"array","items":{"type":"string"}},"nodes":{"type":"array","items":{"type":"object"}},"transitions":{"type":"array","items":{"type":"object"}},"excludedNodes":{"type":"array","items":{"type":"object"}},"inputRequirements":{"type":"array","items":{"type":"object"}}}}}},
      "Artifact":{"$ref":"./artifact-v1alpha1.schema.json#/$defs/artifact"},
      "ArtifactRepresentation":{"$ref":"./artifact-v1alpha1.schema.json#/$defs/representation"},
      "ArtifactBinding":{"$ref":"./artifact-v1alpha1.schema.json#/$defs/artifactBinding"},
      "ArtifactImpactAssessment":{"$ref":"./artifact-v1alpha1.schema.json#/$defs/impactAssessment"},
      "ArtifactTargetKind":{"enum":["project","work","run","node","checkpoint","decision","story","implementation_point"]},
      "ArtifactVersionRef":{"type":"object","additionalProperties":false,"required":["artifactId","version"],"properties":{"artifactId":{"type":"string","pattern":"^artifact_"},"version":{"type":"integer","minimum":1}}},
      "ArtifactTarget":{"type":"object","additionalProperties":false,"required":["kind","id"],"properties":{"kind":{"$ref":"#/components/schemas/ArtifactTargetKind"},"id":{"type":"string","minLength":1}}},
      "ArtifactIngestRequest":{"type":"object","additionalProperties":false,"required":["sourceKind","sourceName","mediaType","content"],"properties":{"artifactId":{"type":"string","pattern":"^artifact_"},"sourceKind":{"enum":["file","paste","stdin","generated","external"]},"sourceName":{"type":"string"},"mediaType":{"type":"string"},"content":{"type":"string","contentEncoding":"base64"},"sensitivity":{"enum":["unknown","public","internal","sensitive","secret"]},"creator":{"type":"string"},"roles":{"type":"array","items":{"type":"string"},"uniqueItems":true},"tags":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},
      "ArtifactIngestResult":{"type":"object","required":["artifact","created","capability","diagnostics"],"properties":{"artifact":{"$ref":"#/components/schemas/Artifact"},"created":{"type":"boolean"},"duplicateOf":{"$ref":"#/components/schemas/ArtifactVersionRef"},"capability":{"type":"object"},"diagnostics":{"type":"array","items":{"type":"string"}}}},
      "ArtifactView":{"type":"object","additionalProperties":false,"required":["artifact","freshness","representations"],"properties":{"artifact":{"$ref":"#/components/schemas/Artifact"},"freshness":{"enum":["current","stale","invalid"]},"representations":{"type":"array","items":{"$ref":"#/components/schemas/ArtifactRepresentation"}}}},
      "ArtifactAttachRequest":{"type":"object","additionalProperties":false,"required":["artifact","target"],"properties":{"bindingId":{"type":"string"},"artifact":{"$ref":"#/components/schemas/ArtifactVersionRef"},"target":{"$ref":"#/components/schemas/ArtifactTarget"}}},
      "ArtifactImpactRequest":{"type":"object","additionalProperties":false,"required":["target"],"properties":{"target":{"$ref":"#/components/schemas/ArtifactTarget"},"runId":{"type":"string"}}},
      "ArtifactLintResult":{"type":"object","additionalProperties":false,"required":["artifact","valid","issues"],"properties":{"artifact":{"$ref":"#/components/schemas/ArtifactVersionRef"},"valid":{"type":"boolean"},"issues":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["code","message"],"properties":{"code":{"type":"string"},"message":{"type":"string"}}}}}},
      "ArtifactVersionDiff":{"type":"object","additionalProperties":false,"required":["artifactId","from","to","changed","fromDigest","toDigest","representations"],"properties":{"artifactId":{"type":"string"},"from":{"type":"integer","minimum":1},"to":{"type":"integer","minimum":1},"changed":{"type":"array","items":{"enum":["content","mediaType","sensitivity","roles","tags"]},"uniqueItems":true},"fromDigest":{"type":"string"},"toDigest":{"type":"string"},"representations":{"type":"object","required":["from","to"],"properties":{"from":{"type":"array","items":{"type":"string"}},"to":{"type":"array","items":{"type":"string"}}}}}},
      "RunExportManifest":{"$ref":"./run-export-manifest-v1alpha1.schema.json"},
      "CreateRunRequest":{"type":"object","additionalProperties":false,"required":["workItemId","workflowId","workflowVersion"],"properties":{"workItemId":{"type":"string"},"workflowId":{"type":"string"},"workflowVersion":{"type":"string"}}},
      "StartFakeRunRequest":{"type":"object","additionalProperties":false,"required":["scenario"],"properties":{"scenario":{"enum":["fake-success","fake-restart"]}}},
      "Run":{"type":"object","additionalProperties":false,"required":["id","workItemId","workflowId","workflowVersion","status","resourceVersion","createdAt","updatedAt"],"properties":{"id":{"type":"string"},"workItemId":{"type":"string"},"workflowId":{"type":"string"},"workflowVersion":{"type":"string"},"status":{"enum":["pending","draft","ready","queued","running","waiting","blocked","completed","failed","cancelled","reconcile_required"]},"resourceVersion":{"type":"integer","minimum":1},"lastGlobalPosition":{"type":"integer","minimum":1},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}}},
      "Attempt":{"type":"object","additionalProperties":false,"required":["id","runId","nodeId","scenario","provider","status","lastSequence","resourceVersion","lastGlobalPosition","createdAt","updatedAt"],"properties":{"id":{"type":"string"},"runId":{"type":"string"},"visitId":{"type":"string"},"nodeId":{"type":"string"},"scenario":{"enum":["fake-success","fake-restart"]},"provider":{"const":"fake"},"status":{"enum":["created","starting","running","validating","succeeded","completed","failed","cancelled","interrupted","reconcile_required"]},"providerThreadId":{"type":"string"},"providerTurnId":{"type":"string"},"processOwnerId":{"type":"string"},"lastSequence":{"type":"integer","minimum":0},"logReference":{"type":"string"},"resourceVersion":{"type":"integer","minimum":1},"lastGlobalPosition":{"type":"integer","minimum":1},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}}},
      "RunView":{"type":"object","additionalProperties":false,"required":["schemaVersion","run","attempts"],"properties":{"schemaVersion":{"const":1},"run":{"$ref":"#/components/schemas/Run"},"attempts":{"type":"array","items":{"$ref":"#/components/schemas/Attempt"}}}},
      "RunPage":{"type":"object","additionalProperties":false,"required":["items","pageInfo"],"properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/Run"}},"pageInfo":{"type":"object","additionalProperties":false,"required":["nextCursor"],"properties":{"nextCursor":{"type":["string","null"]}}}}}
    }
  }
}
