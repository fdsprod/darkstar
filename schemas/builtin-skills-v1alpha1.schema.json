{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkstar.local/schemas/builtin-skills-v1alpha1.schema.json",
  "title": "DARKSTAR built-in skills manifest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "version", "skills"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "darkstar_builtin_skills"},
    "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "class", "version", "path", "source", "fingerprint", "dependencies", "permissions"],
        "properties": {
          "name": {"type": "string", "pattern": "^darkstar:[a-z0-9][a-z0-9.-]*$"},
          "kind": {"const": "skill"},
          "class": {"const": "guaranteed"},
          "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
          "path": {"type": "string", "pattern": "^[a-z0-9-]+/SKILL\\.md$"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "locator"],
            "properties": {
              "type": {"const": "builtin_skill"},
              "locator": {"type": "string", "pattern": "^[a-z0-9-]+/SKILL\\.md$"}
            }
          },
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
