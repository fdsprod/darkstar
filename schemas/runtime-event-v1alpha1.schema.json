{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkstar.local/schemas/runtime-event-v1alpha1.schema.json",
  "title": "DARKSTAR runtime event v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","id","globalPosition","aggregateType","aggregateId","aggregateRevision","kind","occurredAt","recordedAt","correlationId","causationId","commandId","actor","data","metadata"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type":"string","pattern":"^event_[0-9A-HJKMNP-TV-Z]{26}$"},
    "globalPosition": {"type":"integer","minimum":1},
    "aggregateType": {"enum":["project","work","run","visit","attempt","artifact","approval","operation"]},
    "aggregateId": {"type":"string","pattern":"^(project|work|run|visit|attempt|artifact|approval|operation)_[0-9A-HJKMNP-TV-Z]{26}$"},
    "aggregateRevision": {"type":"integer","minimum":1},
    "kind": {"type":"string","pattern":"^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "occurredAt": {"type":"string","format":"date-time"},
    "recordedAt": {"type":"string","format":"date-time"},
    "correlationId": {"type":"string","minLength":1,"maxLength":128},
    "causationId": {"type":["string","null"],"maxLength":128},
    "commandId": {"type":"string","minLength":1,"maxLength":128},
    "actor": {
      "type":"object","additionalProperties":false,"required":["type","id"],
      "properties":{"type":{"enum":["user","system","provider","external"]},"id":{"type":"string","minLength":1,"maxLength":128}}
    },
    "data": {"type":"object"},
    "metadata": {"type":"object"}
  }
}
