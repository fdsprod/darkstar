{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkstar.local/schemas/runtime-event-v1alpha1.schema.json",
  "title": "DARKSTAR runtime event v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","id","globalPosition","aggregateType","aggregateId","aggregateRevision","kind","occurredAt","recordedAt","correlationId","causationId","commandId","actor","data","metadata"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type":"string","pattern":"^event_[0-9A-HJKMNP-TV-Z]{26}$"},
    "globalPosition": {"type":"integer","minimum":1},
    "aggregateType": {"enum":["project","work","story","point","run","visit","attempt","artifact","approval","operation","assessment","input"]},
    "aggregateId": {"type":"string","pattern":"^(project|work|story|point|run|visit|attempt|artifact|approval|operation|assessment|input)_[0-9A-HJKMNP-TV-Z]{26}$"},
    "aggregateRevision": {"type":"integer","minimum":1},
    "kind": {"type":"string","pattern":"^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "occurredAt": {"type":"string","format":"date-time"},
    "recordedAt": {"type":"string","format":"date-time"},
    "correlationId": {"type":"string","minLength":1,"maxLength":128},
    "causationId": {"type":["string","null"],"maxLength":128},
    "commandId": {"type":"string","minLength":1,"maxLength":128},
    "actor": {
      "type":"object","additionalProperties":false,"required":["type","id"],
      "properties":{"type":{"enum":["user","system","provider","external"]},"id":{"type":"string","minLength":1,"maxLength":128}}
    },
    "data": {"type":"object"},
    "metadata": {"type":"object"}
  },
  "oneOf": [
    {"properties":{"aggregateType":{"const":"project"},"aggregateId":{"type":"string","pattern":"^project_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["aggregateType","aggregateId"]},
    {"properties":{"aggregateType":{"const":"work"},"aggregateId":{"type":"string","pattern":"^work_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["aggregateType","aggregateId"]},
    {"properties":{"aggregateType":{"const":"story"},"aggregateId":{"type":"string","pattern":"^story_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["aggregateType","aggregateId"]},
    {"properties":{"aggregateType":{"const":"point"},"aggregateId":{"type":"string","pattern":"^point_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["aggregateType","aggregateId"]},
    {"properties":{"aggregateType":{"const":"run"},"aggregateId":{"type":"string","pattern":"^run_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["aggregateType","aggregateId"]},
    {"properties":{"aggregateType":{"const":"visit"},"aggregateId":{"type":"string","pattern":"^visit_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["aggregateType","aggregateId"]},
    {"properties":{"aggregateType":{"const":"attempt"},"aggregateId":{"type":"string","pattern":"^attempt_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["aggregateType","aggregateId"]},
    {"properties":{"aggregateType":{"const":"artifact"},"aggregateId":{"type":"string","pattern":"^artifact_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["aggregateType","aggregateId"]},
    {"properties":{"aggregateType":{"const":"approval"},"aggregateId":{"type":"string","pattern":"^approval_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["aggregateType","aggregateId"]},
    {"properties":{"aggregateType":{"const":"operation"},"aggregateId":{"type":"string","pattern":"^operation_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["aggregateType","aggregateId"]},
    {"properties":{"aggregateType":{"const":"assessment"},"aggregateId":{"type":"string","pattern":"^assessment_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["aggregateType","aggregateId"]},
    {"properties":{"aggregateType":{"const":"input"},"aggregateId":{"type":"string","pattern":"^input_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["aggregateType","aggregateId"]}
  ]
}
