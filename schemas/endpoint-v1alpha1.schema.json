{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkstar.local/schemas/endpoint-v1alpha1.schema.json",
  "title": "DARKSTAR daemon endpoint v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","apiVersion","pid","processStartedAt","port","token","createdAt"],
  "properties": {
    "schemaVersion": {"const":1},
    "apiVersion": {"const":"v1"},
    "pid": {"type":"integer","minimum":1},
    "processStartedAt": {"type":"string","format":"date-time"},
    "port": {"type":"integer","minimum":1,"maximum":65535},
    "token": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "createdAt": {"type":"string","format":"date-time"}
  }
}
