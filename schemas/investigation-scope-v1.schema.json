{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkstar.local/schemas/investigation-scope-v1.schema.json",
  "title": "Immutable repository investigation scopes",
  "description": "Explicit no-repository or committed read-only scope with frozen membership/configuration, independent materialization state, and immutable evidence. Preparation grants no provider capability or Git write authority.",
  "$ref": "#/$defs/InvestigationScopeView",
  "$defs": {
    "RepositorySelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repositoryId": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      },
      "required": [
        "repositoryId",
        "ref"
      ]
    },
    "PrepareInvestigationScopeRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^project_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "repositories": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/RepositorySelection"
          },
          "description": "Explicit selection; an empty array creates a no-repository scope. Repository IDs must be unique."
        }
      },
      "required": [
        "projectId",
        "repositories"
      ]
    },
    "RepositorySettingSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "default",
            "system",
            "user",
            "repository",
            "project",
            "membership",
            "run",
            "cli"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "configurationRoot": {
          "type": "string"
        }
      },
      "required": [
        "scope",
        "reference"
      ]
    },
    "ResolvedRepositorySettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settings": {
          "$ref": "repository-membership-v2.schema.json#/$defs/RepositorySettings"
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RepositorySettingSource"
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "settings",
        "sources",
        "digest"
      ]
    },
    "ResolvedRevision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commitSha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "treeSha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        }
      },
      "required": [
        "commitSha",
        "treeSha"
      ]
    },
    "FrozenRepositoryScopeEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "$ref": "repository-membership-v2.schema.json#/$defs/RepositoryRecord"
        },
        "membership": {
          "$ref": "repository-membership-v2.schema.json#/$defs/RepositoryMembership"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/ResolvedRevision"
        },
        "configuration": {
          "$ref": "#/$defs/ResolvedRepositorySettings"
        },
        "configurationDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "repository",
        "membership",
        "ref",
        "revision",
        "configuration",
        "configurationDigest"
      ]
    },
    "NoRepositoryScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^scope_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^project_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "projectRevision": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "const": "none"
        },
        "repositories": {
          "type": "array",
          "minItems": 0,
          "maxItems": 0,
          "items": {
            "$ref": "#/$defs/FrozenRepositoryScopeEntry"
          }
        },
        "contentPolicy": {
          "const": "committed_only"
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "projectId",
        "projectRevision",
        "mode",
        "repositories",
        "contentPolicy",
        "requestDigest",
        "digest",
        "createdAt"
      ]
    },
    "ReadOnlyRepositoryScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^scope_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^project_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "projectRevision": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "const": "read_only"
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/FrozenRepositoryScopeEntry"
          }
        },
        "contentPolicy": {
          "const": "committed_only"
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "projectId",
        "projectRevision",
        "mode",
        "repositories",
        "contentPolicy",
        "requestDigest",
        "digest",
        "createdAt"
      ]
    },
    "RepositoryScope": {
      "oneOf": [
        {
          "$ref": "#/$defs/NoRepositoryScope"
        },
        {
          "$ref": "#/$defs/ReadOnlyRepositoryScope"
        }
      ]
    },
    "RepositoryScopePreparation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "preparing",
                "ready"
              ]
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "status",
            "revision",
            "updatedAt"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "blocked"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "status",
            "reason",
            "revision",
            "updatedAt"
          ]
        }
      ]
    },
    "SnapshotExclusion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "symlink",
            "gitlink",
            "lfs_pointer"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "kind",
        "reason"
      ]
    },
    "SnapshotEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cacheKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SnapshotExclusion"
          }
        }
      },
      "required": [
        "cacheKey",
        "root",
        "manifestDigest",
        "fileCount",
        "totalBytes",
        "exclusions"
      ]
    },
    "RepositoryScopeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scopeId": {
          "type": "string",
          "pattern": "^scope_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/SnapshotEvidence"
        }
      },
      "required": [
        "scopeId",
        "repositoryId",
        "evidence"
      ]
    },
    "InvestigationScopeView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "scope": {
          "$ref": "#/$defs/RepositoryScope"
        },
        "preparation": {
          "$ref": "#/$defs/RepositoryScopePreparation"
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/RepositoryScopeEvidence"
          }
        }
      },
      "required": [
        "schemaVersion",
        "scope",
        "preparation",
        "evidence"
      ]
    }
  }
}
