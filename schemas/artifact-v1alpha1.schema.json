{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkstar.local/schemas/artifact-v1alpha1.schema.json",
  "title": "DARKSTAR artifact boundary v1alpha1",
  "oneOf": [
    {"$ref": "#/$defs/artifact"},
    {"$ref": "#/$defs/representation"},
    {"$ref": "#/$defs/impactAssessment"},
    {"$ref": "#/$defs/artifactBinding"},
    {"$ref": "#/$defs/contextManifest"}
  ],
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 255},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "artifactId", "sourceKind", "sourceName", "blobDigest", "size", "declaredMediaType", "detectedMediaType", "locator", "sensitivity", "trust", "creator", "status", "createdAt", "provenance"],
      "properties": {
        "kind": {"const": "artifact"},
        "schemaVersion": {"const": 1},
        "artifactId": {"$ref": "#/$defs/identifier"},
        "version": {"type": "integer", "minimum": 1},
        "sourceKind": {"enum": ["file", "paste", "stdin", "generated", "external"]},
        "sourceName": {"type": "string"},
        "blobDigest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0},
        "declaredMediaType": {"type": "string", "minLength": 1},
        "detectedMediaType": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "sensitivity": {"enum": ["unknown", "public", "internal", "sensitive", "secret"]},
        "trust": {"const": "untrusted"},
        "creator": {"type": "string", "minLength": 1},
        "producer": {"$ref": "#/$defs/producer"},
        "roles": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "tags": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "metadata": {"type": "object", "additionalProperties": {"type": "string"}},
        "status": {"enum": ["stored", "stored_uninspectable", "quarantined"]},
        "createdAt": {"type": "string", "format": "date-time"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "runId", "nodeId", "attemptId", "operationId"],
          "properties": {
            "origin": {"const": "attempt"},
            "runId": {"$ref": "#/$defs/identifier"},
            "nodeId": {"$ref": "#/$defs/identifier"},
            "attemptId": {"$ref": "#/$defs/identifier"},
            "operationId": {"$ref": "#/$defs/identifier"},
            "sourceArtifactId": {"$ref": "#/$defs/identifier"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "operationId"],
          "properties": {
            "origin": {"const": "operation"},
            "operationId": {"$ref": "#/$defs/identifier"},
            "sourceArtifactId": {"$ref": "#/$defs/identifier"}
          }
        }
      ]
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "representationId", "artifactId", "representationKind", "processorName", "processorVersion", "mediaType", "locator", "digest", "size", "tokenEstimate", "truncated", "disclosure", "diagnostics", "createdAt"],
      "properties": {
        "kind": {"const": "representation"},
        "schemaVersion": {"const": 1},
        "representationId": {"$ref": "#/$defs/identifier"},
        "artifactId": {"$ref": "#/$defs/identifier"},
        "representationKind": {"enum": ["text", "structured", "table", "image", "preview", "descriptor"]},
        "processorName": {"type": "string", "minLength": 1},
        "processorVersion": {"type": "string", "minLength": 1},
        "mediaType": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0},
        "tokenEstimate": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "disclosure": {"enum": ["raw", "redacted", "withheld"]},
        "diagnostics": {"type": "array", "items": {"type": "string"}},
        "metadata": {"type": "object", "additionalProperties": {"type": "string"}},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "artifactVersionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "version"],
      "properties": {
        "artifactId": {"$ref": "#/$defs/identifier"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "bindingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["project", "work", "run", "node", "checkpoint", "decision", "story", "implementation_point"]},
        "id": {"$ref": "#/$defs/identifier"}
      }
    },
    "attemptCoverage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["attemptId", "nodeId", "manifestId", "state"],
          "properties": {
            "attemptId": {"$ref": "#/$defs/identifier"},
            "nodeId": {"$ref": "#/$defs/identifier"},
            "manifestId": {"$ref": "#/$defs/identifier"},
            "state": {"enum": ["supplied", "not_supplied"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["attemptId", "nodeId", "state"],
          "properties": {
            "attemptId": {"$ref": "#/$defs/identifier"},
            "nodeId": {"$ref": "#/$defs/identifier"},
            "state": {"enum": ["pending_freeze", "unavailable"]}
          }
        }
      ]
    },
    "artifactEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "freshness"],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifactVersionRef"},
        "freshness": {"enum": ["potentially_stale", "invalidated"]}
      }
    },
    "impactProposal": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "reason"],
          "properties": {"action": {"const": "continue"}, "reason": {"type": "string", "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "attemptId", "reason"],
          "properties": {
            "action": {"const": "refresh"},
            "attemptId": {"$ref": "#/$defs/identifier"},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "artifacts", "reason"],
          "properties": {
            "action": {"const": "revise"},
            "artifacts": {
              "type": "array", "minItems": 1,
              "items": {
                "allOf": [
                  {"$ref": "#/$defs/artifactEffect"},
                  {"properties": {"freshness": {"const": "potentially_stale"}}}
                ]
              }
            },
            "reason": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "runId", "target", "roles", "reason"],
          "properties": {
            "action": {"const": "insert"},
            "runId": {"$ref": "#/$defs/identifier"},
            "target": {"$ref": "#/$defs/bindingTarget"},
            "roles": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "artifacts", "reason"],
          "properties": {
            "action": {"const": "invalidate"},
            "artifacts": {
              "type": "array", "minItems": 1,
              "items": {
                "allOf": [
                  {"$ref": "#/$defs/artifactEffect"},
                  {"properties": {"freshness": {"const": "invalidated"}}}
                ]
              }
            },
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "impactAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "evidence", "target", "roles", "coverage", "proposals"],
      "properties": {
        "kind": {"const": "impact_assessment"},
        "schemaVersion": {"const": 1},
        "evidence": {"$ref": "#/$defs/artifactVersionRef"},
        "target": {"$ref": "#/$defs/bindingTarget"},
        "runId": {"$ref": "#/$defs/identifier"},
        "roles": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "coverage": {"type": "array", "items": {"$ref": "#/$defs/attemptCoverage"}},
        "proposals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/impactProposal"}}
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "bindingId", "artifactId", "representationId", "runId", "nodeId", "attemptId", "inputName", "disposition", "rank", "policyVersion", "createdAt"],
      "properties": {
        "kind": {"const": "artifact_binding"},
        "schemaVersion": {"const": 1},
        "bindingId": {"$ref": "#/$defs/identifier"},
        "artifactId": {"$ref": "#/$defs/identifier"},
        "representationId": {"type": ["string", "null"]},
        "runId": {"$ref": "#/$defs/identifier"},
        "nodeId": {"$ref": "#/$defs/identifier"},
        "attemptId": {"type": ["string", "null"]},
        "inputName": {"$ref": "#/$defs/identifier"},
        "disposition": {"enum": ["required", "optional"]},
        "rank": {"type": "integer", "minimum": 0},
        "policyVersion": {"type": "string", "minLength": 1},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "contextEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representationId", "artifactId", "digest", "required", "tokenEstimate"],
      "properties": {
        "representationId": {"$ref": "#/$defs/identifier"},
        "artifactId": {"$ref": "#/$defs/identifier"},
        "artifactVersion": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "required": {"type": "boolean"},
        "tokenEstimate": {"type": "integer", "minimum": 0}
      }
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "workspaceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest", "access"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "digest": {"$ref": "#/$defs/digest"},
        "access": {"enum": ["read_only", "workspace_write"]}
      }
    },
    "capabilitySelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "class", "fingerprint", "source", "permissions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["skill", "tool"]},
        "class": {"enum": ["guaranteed", "registered", "inherited"]},
        "version": {"type": "string", "minLength": 1},
        "fingerprint": {"$ref": "#/$defs/digest"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "locator"],
          "properties": {
            "type": {"type": "string", "minLength": 1},
            "locator": {"type": "string", "minLength": 1}
          }
        },
        "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "contextManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "manifestId", "runId", "nodeId", "attemptId", "policyVersion", "budget", "entries", "omissions", "digest", "frozenAt"],
      "properties": {
        "kind": {"const": "context_manifest"},
        "schemaVersion": {"const": 1},
        "manifestId": {"$ref": "#/$defs/identifier"},
        "runId": {"$ref": "#/$defs/identifier"},
        "nodeId": {"$ref": "#/$defs/identifier"},
        "attemptId": {"$ref": "#/$defs/identifier"},
        "policyVersion": {"type": "string", "minLength": 1},
        "budget": {"type": "integer", "minimum": 0},
        "reservedTokens": {"type": "integer", "minimum": 0},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/contextEntry"}},
        "omissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["representationId", "reason"],
            "properties": {"representationId": {"$ref": "#/$defs/identifier"}, "reason": {"type": "string", "minLength": 1}}
          }
        },
        "instructions": {"type": "array", "items": {"$ref": "#/$defs/digestRef"}},
        "schemas": {"type": "array", "items": {"$ref": "#/$defs/digestRef"}},
        "permissions": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "workspace": {"$ref": "#/$defs/workspaceSnapshot"},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capabilitySelection"}},
        "digest": {"$ref": "#/$defs/digest"},
        "frozenAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
