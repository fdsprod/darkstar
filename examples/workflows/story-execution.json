{
  "apiVersion": "darkstar.local/v1alpha3",
  "kind": "Workflow",
  "metadata": {
    "name": "darkstar/story-execution",
    "version": "2.0.3",
    "displayName": "Story execution"
  },
  "spec": {
    "inputs": {
      "story": {
        "type": "task",
        "resource": {
          "kind": "task"
        }
      },
      "repository": {
        "type": "repository",
        "resource": {
          "kind": "repository"
        }
      },
      "needs_clarification": {
        "type": "boolean",
        "resource": {
          "kind": "constant",
          "value": true
        }
      },
      "needs_research": {
        "type": "boolean",
        "resource": {
          "kind": "constant",
          "value": true
        }
      },
      "needs_design": {
        "type": "boolean",
        "resource": {
          "kind": "constant",
          "value": true
        }
      },
      "open_items": {
        "type": "open_items",
        "resource": {
          "kind": "open_items"
        }
      },
      "decision_log": {
        "type": "decision_log",
        "resource": {
          "kind": "decision_log"
        }
      },
      "s0_readiness_template": {
        "type": "template",
        "resource": {
          "kind": "template",
          "version": "1.0.0",
          "content": "# Story intake and readiness\n\n## Questions\n\nDescribe questions using the supplied task and evidence.\n\n## Known context\n\nDescribe known context using the supplied task and evidence.\n",
          "requiredHeadings": [
            "Questions",
            "Known context"
          ]
        }
      },
      "s2_research_template": {
        "type": "template",
        "resource": {
          "kind": "template",
          "version": "1.0.0",
          "content": "# Focused developer research\n\n## Overview\n\nDescribe overview using the supplied task and evidence.\n\n## Approach\n\nDescribe approach using the supplied task and evidence.\n\n## Validation\n\nDescribe validation using the supplied task and evidence.\n",
          "requiredHeadings": [
            "Overview",
            "Approach",
            "Validation"
          ]
        }
      },
      "s3_design_template": {
        "type": "template",
        "resource": {
          "kind": "template",
          "version": "1.0.0",
          "content": "# Story-level design\n\n## Overview\n\nDescribe overview using the supplied task and evidence.\n\n## Approach\n\nDescribe approach using the supplied task and evidence.\n\n## Validation\n\nDescribe validation using the supplied task and evidence.\n",
          "requiredHeadings": [
            "Overview",
            "Approach",
            "Validation"
          ]
        }
      },
      "s4_plan_template": {
        "type": "template",
        "resource": {
          "kind": "template",
          "version": "1.0.0",
          "content": "# Implementation plan\n\n## Overview\n\nDescribe overview using the supplied task and evidence.\n\n## Approach\n\nDescribe approach using the supplied task and evidence.\n\n## Validation\n\nDescribe validation using the supplied task and evidence.\n",
          "requiredHeadings": [
            "Overview",
            "Approach",
            "Validation"
          ]
        }
      }
    },
    "routeDefaults": {
      "entry": "s0_readiness",
      "terminals": [
        "s6_validation"
      ]
    },
    "profiles": {
      "accepted_story": {
        "description": "Execute an accepted story through validation.",
        "entry": "s0_readiness",
        "terminals": [
          "s6_validation"
        ],
        "inputDefaults": {
          "needs_clarification": true,
          "needs_research": true,
          "needs_design": true
        }
      },
      "implementation_only": {
        "description": "Execute an accepted implementation plan and validate the story.",
        "entry": "s5_implementation",
        "terminals": [
          "s6_validation"
        ],
        "inputDefaults": {}
      },
      "bug": {
        "description": "Investigate and implement a focused defect repair.",
        "entry": "s0_readiness",
        "terminals": [
          "s6_validation"
        ],
        "inputDefaults": {
          "needs_clarification": false,
          "needs_research": true,
          "needs_design": false
        }
      },
      "validation": {
        "description": "Run story validation only and stop with its report.",
        "entry": "s6_validation",
        "terminals": [
          "s6_validation"
        ],
        "inputDefaults": {}
      }
    },
    "nodes": {
      "s0_readiness": {
        "displayName": "Questions and readiness",
        "type": "reasoning",
        "entry": true,
        "terminal": true,
        "inputs": {
          "story": {
            "from": "run.input.story",
            "type": "task"
          },
          "repository": {
            "from": "run.input.repository",
            "type": "repository"
          },
          "template": {
            "from": "run.input.s0_readiness_template",
            "type": "template"
          },
          "open_items": {
            "from": "run.input.open_items",
            "type": "open_items"
          },
          "decision_log": {
            "from": "run.input.decision_log",
            "type": "decision_log"
          }
        },
        "outputs": {
          "questions": {
            "type": "markdown",
            "artifact": {
              "filename": "questions.md",
              "templateInput": "template"
            }
          }
        },
        "readiness": {
          "recommendedEvidence": [
            {
              "role": "accepted_story",
              "description": "Story outcome, acceptance criteria, dependencies, and relevant accepted artifacts."
            }
          ],
          "policyGates": [
            {
              "policy": "story_readiness",
              "enforcement": "advisory",
              "description": "Missing recommended context produces guidance; required policy inputs still block."
            }
          ],
          "invariants": [
            "The story terminal boundary and explicit human instructions remain authoritative."
          ],
          "remedies": [
            {
              "code": "story_context_missing",
              "target": "s0_readiness",
              "action": "supply_input",
              "description": "Supply the missing story, repository, acceptance, or dependency context."
            }
          ]
        },
        "reasoning": {
          "agent": "story-readiness",
          "skills": [
            "darkstar:readiness"
          ],
          "instructions": "Produce questions.md as the single document deliverable, following the connected template. Read connected upstream Markdown documents. Record open items and decisions with their tools."
        },
        "transitions": [
          {
            "id": "s0_to_clarify_branch",
            "to": "clarify_branch"
          }
        ]
      },
      "s1_clarification": {
        "displayName": "Clarification",
        "type": "approval",
        "entry": true,
        "terminal": true,
        "inputs": {
          "story": {
            "from": "run.input.story",
            "type": "task"
          },
          "questions": {
            "from": "node.s0_readiness.output.questions",
            "type": "markdown",
            "required": false
          }
        },
        "outputs": {
          "answers": {
            "type": "markdown",
            "artifact": {
              "filename": "answers.md"
            }
          }
        },
        "readiness": {
          "recommendedEvidence": [
            {
              "role": "blocking_questions",
              "description": "Only questions whose answers can change scope, design, permissions, or acceptance."
            }
          ],
          "policyGates": [
            {
              "policy": "owner_clarification",
              "enforcement": "blocking",
              "description": "The configured owner supplies load-bearing answers."
            }
          ],
          "invariants": [
            "The workflow never invents an answer to continue execution."
          ],
          "remedies": [
            {
              "code": "clarification_unresolved",
              "target": "s0_readiness",
              "action": "clarify_decision",
              "description": "Refine the blocking question and route it to the responsible owner."
            }
          ]
        },
        "approval": {
          "actor": "work-item-owner"
        },
        "transitions": [
          {
            "id": "s1_to_research_branch",
            "to": "research_branch"
          }
        ]
      },
      "s2_research": {
        "displayName": "Focused developer research",
        "type": "reasoning",
        "entry": true,
        "terminal": true,
        "inputs": {
          "story": {
            "from": "run.input.story",
            "type": "task"
          },
          "repository": {
            "from": "run.input.repository",
            "type": "repository"
          },
          "answers": {
            "from": "node.s1_clarification.output.answers",
            "type": "markdown",
            "required": false
          },
          "template": {
            "from": "run.input.s2_research_template",
            "type": "template"
          },
          "open_items": {
            "from": "run.input.open_items",
            "type": "open_items"
          },
          "decision_log": {
            "from": "run.input.decision_log",
            "type": "decision_log"
          },
          "questions": {
            "from": "node.s0_readiness.output.questions",
            "type": "markdown",
            "required": false
          }
        },
        "outputs": {
          "research": {
            "type": "markdown",
            "artifact": {
              "filename": "research.md",
              "templateInput": "template"
            }
          }
        },
        "readiness": {
          "recommendedEvidence": [
            {
              "role": "focused_uncertainty",
              "description": "A named uncertainty that can change the implementation plan."
            }
          ],
          "policyGates": [
            {
              "policy": "artifact_approval",
              "enforcement": "blocking",
              "description": "Activated story research is accepted before local design or planning."
            }
          ],
          "invariants": [
            "Research remains focused, sourced, and read-only."
          ],
          "remedies": [
            {
              "code": "story_evidence_missing",
              "target": "s2_research",
              "action": "supply_input",
              "description": "Gather the specific repository or dependency evidence needed by the plan."
            }
          ]
        },
        "reasoning": {
          "agent": "story-researcher",
          "skills": [
            "darkstar:evidence-research"
          ],
          "instructions": "Produce research.md as the single document deliverable, following the connected template. Read connected upstream Markdown documents. Record open items and decisions with their tools."
        },
        "checkpoint": "approve",
        "transitions": [
          {
            "id": "s2_to_design_branch",
            "to": "design_branch"
          }
        ]
      },
      "s3_design": {
        "displayName": "Story-level design",
        "type": "reasoning",
        "entry": true,
        "terminal": true,
        "inputs": {
          "story": {
            "from": "run.input.story",
            "type": "task"
          },
          "repository": {
            "from": "run.input.repository",
            "type": "repository"
          },
          "research": {
            "from": "node.s2_research.output.research",
            "type": "markdown",
            "required": false
          },
          "template": {
            "from": "run.input.s3_design_template",
            "type": "template"
          },
          "open_items": {
            "from": "run.input.open_items",
            "type": "open_items"
          },
          "decision_log": {
            "from": "run.input.decision_log",
            "type": "decision_log"
          },
          "questions": {
            "from": "node.s0_readiness.output.questions",
            "type": "markdown",
            "required": false
          },
          "answers": {
            "from": "node.s1_clarification.output.answers",
            "type": "markdown",
            "required": false
          }
        },
        "outputs": {
          "design": {
            "type": "markdown",
            "artifact": {
              "filename": "design.md",
              "templateInput": "template"
            }
          }
        },
        "readiness": {
          "recommendedEvidence": [
            {
              "role": "local_design_context",
              "description": "Accepted story intent plus the focused research that informs this decision."
            }
          ],
          "policyGates": [
            {
              "policy": "artifact_approval",
              "enforcement": "blocking",
              "description": "Activated story design is accepted before implementation planning."
            }
          ],
          "invariants": [
            "Local design does not contradict accepted product or initiative-level technical decisions."
          ],
          "remedies": [
            {
              "code": "story_design_blocked",
              "target": "s2_research",
              "action": "revise_artifact",
              "description": "Resolve the focused uncertainty that prevents the local design decision."
            }
          ]
        },
        "reasoning": {
          "agent": "story-designer",
          "skills": [
            "darkstar:technical-design"
          ],
          "instructions": "Produce design.md as the single document deliverable, following the connected template. Read connected upstream Markdown documents. Record open items and decisions with their tools."
        },
        "checkpoint": "approve",
        "transitions": [
          {
            "id": "s3_to_s4",
            "to": "s4_plan"
          }
        ]
      },
      "s4_plan": {
        "displayName": "Implementation plan",
        "type": "reasoning",
        "entry": true,
        "terminal": true,
        "inputs": {
          "story": {
            "from": "run.input.story",
            "type": "task"
          },
          "repository": {
            "from": "run.input.repository",
            "type": "repository"
          },
          "design": {
            "from": "node.s3_design.output.design",
            "type": "markdown",
            "required": false
          },
          "template": {
            "from": "run.input.s4_plan_template",
            "type": "template"
          },
          "open_items": {
            "from": "run.input.open_items",
            "type": "open_items"
          },
          "decision_log": {
            "from": "run.input.decision_log",
            "type": "decision_log"
          },
          "questions": {
            "from": "node.s0_readiness.output.questions",
            "type": "markdown",
            "required": false
          },
          "answers": {
            "from": "node.s1_clarification.output.answers",
            "type": "markdown",
            "required": false
          },
          "research_document": {
            "from": "node.s2_research.output.research",
            "type": "markdown",
            "required": false
          }
        },
        "outputs": {
          "plan": {
            "type": "markdown",
            "artifact": {
              "filename": "plan.md",
              "templateInput": "template"
            }
          }
        },
        "readiness": {
          "recommendedEvidence": [
            {
              "role": "accepted_story_design",
              "description": "The accepted story, relevant research, and local design decisions."
            }
          ],
          "policyGates": [
            {
              "policy": "implementation_plan_approval",
              "enforcement": "blocking",
              "description": "The ordered implementation points are approved before repository writes."
            }
          ],
          "invariants": [
            "Each point is an atomic vertical slice with acceptance, tests, rollback, and a commit boundary."
          ],
          "remedies": [
            {
              "code": "implementation_plan_incomplete",
              "target": "s3_design",
              "action": "revise_artifact",
              "description": "Resolve the missing design decision or revise the affected implementation point."
            }
          ]
        },
        "reasoning": {
          "agent": "implementation-planner",
          "skills": [
            "darkstar:tracer-bullets"
          ],
          "instructions": "Produce plan.md as the single document deliverable, following the connected template. Read connected upstream Markdown documents. Record open items and decisions with their tools."
        },
        "checkpoint": "approve",
        "transitions": [
          {
            "id": "s4_to_s5",
            "to": "s5_implementation"
          }
        ],
        "join": {
          "mode": "one",
          "from": [
            "design_branch_false",
            "s3_to_s4"
          ]
        }
      },
      "s5_implementation": {
        "displayName": "Implementation-point loop",
        "type": "point_execution",
        "entry": true,
        "terminal": false,
        "join": {
          "mode": "one",
          "from": [
            "s4_to_s5",
            "s5_more_points"
          ]
        },
        "inputs": {
          "story": {
            "from": "run.input.story",
            "type": "task"
          },
          "repository": {
            "from": "run.input.repository",
            "type": "repository"
          },
          "implementation_plan": {
            "from": "node.s4_plan.output.plan",
            "type": "markdown",
            "required": false
          },
          "prior_changeset": {
            "from": "node.s5_implementation.output.changeset",
            "type": "schema:changeset",
            "required": false
          },
          "open_items": {
            "from": "run.input.open_items",
            "type": "open_items"
          },
          "decision_log": {
            "from": "run.input.decision_log",
            "type": "decision_log"
          }
        },
        "outputs": {
          "changeset": {
            "type": "schema:changeset",
            "schemaDefinition": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "validation": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "summary",
                "files",
                "validation"
              ],
              "additionalProperties": false
            }
          },
          "progress": {
            "type": "schema:progress",
            "schemaDefinition": {
              "type": "object",
              "properties": {
                "completed_points": {
                  "type": "integer"
                },
                "remaining_points": {
                  "type": "integer"
                }
              },
              "required": [
                "completed_points",
                "remaining_points"
              ],
              "additionalProperties": false
            }
          }
        },
        "readiness": {
          "recommendedEvidence": [
            {
              "role": "approved_implementation_plan",
              "description": "The approved point, clean baseline, required capabilities, and validation commands."
            }
          ],
          "policyGates": [
            {
              "policy": "implementation_point",
              "enforcement": "blocking",
              "description": "Repository write authority and point preconditions must be satisfied."
            }
          ],
          "invariants": [
            "Only the active point changes; validation precedes its atomic commit."
          ],
          "remedies": [
            {
              "code": "implementation_point_failed",
              "target": "s4_plan",
              "action": "revise_artifact",
              "description": "Revise the affected point when its scope or validation plan is unsound."
            }
          ]
        },
        "points": {
          "planInput": "implementation_plan",
          "approval": "none",
          "riskTags": [],
          "validation": "each_and_combined",
          "publishing": "after_story_validation"
        },
        "permissions": [
          "workspace.write",
          "process.run"
        ],
        "transitions": [
          {
            "id": "s5_to_progress_gate",
            "to": "s5_progress_gate"
          }
        ]
      },
      "s5_progress_gate": {
        "displayName": "Deterministic implementation-progress gate",
        "type": "gate",
        "entry": false,
        "terminal": false,
        "inputs": {
          "progress": {
            "from": "node.s5_implementation.output.progress",
            "type": "schema:progress"
          }
        },
        "outputs": {
          "passed": {
            "type": "boolean"
          },
          "gate_evidence": {
            "type": "schema:gate_evidence",
            "schemaDefinition": {
              "type": "object",
              "properties": {
                "policy": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                }
              },
              "required": [
                "policy",
                "passed"
              ],
              "additionalProperties": false
            }
          }
        },
        "readiness": {
          "recommendedEvidence": [
            {
              "role": "point_progress",
              "description": "Committed point evidence and the remaining approved point count."
            }
          ],
          "policyGates": [
            {
              "policy": "point_progress",
              "enforcement": "blocking",
              "description": "The deterministic gate decides whether another bounded point iteration is required."
            }
          ],
          "invariants": [
            "The point loop cannot exceed its authored traversal budget."
          ],
          "remedies": [
            {
              "code": "point_progress_invalid",
              "target": "s5_implementation",
              "action": "rerun_validation",
              "description": "Correct or revalidate the point progress record before continuing."
            }
          ]
        },
        "gate": {
          "policy": "darkstar/implementation-points-complete-v1",
          "condition": {
            "op": "eq",
            "args": [
              {
                "ref": "input.progress.remaining_points"
              },
              {
                "literal": 0
              }
            ]
          }
        },
        "transitions": [
          {
            "id": "s5_more_points",
            "to": "s5_implementation",
            "kind": "bounded",
            "maxTraversals": 20,
            "when": {
              "op": "eq",
              "args": [
                {
                  "ref": "output.passed"
                },
                {
                  "literal": false
                }
              ]
            }
          },
          {
            "id": "s5_to_s6",
            "to": "s6_validation",
            "when": {
              "op": "eq",
              "args": [
                {
                  "ref": "output.passed"
                },
                {
                  "literal": true
                }
              ]
            }
          }
        ]
      },
      "s6_validation": {
        "displayName": "Story validation and acceptance coverage",
        "type": "command",
        "entry": true,
        "terminal": true,
        "inputs": {
          "story": {
            "from": "run.input.story",
            "type": "task"
          },
          "repository": {
            "from": "run.input.repository",
            "type": "repository"
          },
          "changeset": {
            "from": "node.s5_implementation.output.changeset",
            "type": "schema:changeset",
            "required": false
          }
        },
        "outputs": {
          "validation": {
            "type": "schema:validation",
            "schemaDefinition": {
              "type": "object",
              "properties": {
                "passed": {
                  "type": "boolean"
                },
                "acceptanceCovered": {
                  "type": "boolean"
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "string"
                      },
                      "passed": {
                        "type": "boolean"
                      },
                      "changedEntries": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "command",
                      "passed"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "passed",
                "acceptanceCovered",
                "checks"
              ],
              "additionalProperties": false
            }
          }
        },
        "readiness": {
          "recommendedEvidence": [
            {
              "role": "validated_changeset",
              "description": "All atomic point commits and their focused validation evidence."
            }
          ],
          "policyGates": [
            {
              "policy": "story_validation",
              "enforcement": "blocking",
              "description": "Integrated story checks and acceptance coverage must pass."
            }
          ],
          "invariants": [
            "Completion is based on observed validation and acceptance coverage."
          ],
          "remedies": [
            {
              "code": "story_validation_failed",
              "target": "s5_implementation",
              "action": "rerun_validation",
              "description": "Repair the failing point or acceptance gap and rerun story validation."
            }
          ]
        },
        "command": {
          "argv": [
            "darkstar-project",
            "validate",
            "--json"
          ],
          "timeoutSeconds": 1800
        },
        "transitions": []
      },
      "clarify_branch": {
        "displayName": "needs clarification",
        "type": "gate",
        "inputs": {
          "condition": {
            "from": "run.input.needs_clarification",
            "type": "boolean"
          }
        },
        "outputs": {
          "passed": {
            "type": "boolean"
          },
          "gate_evidence": {
            "type": "schema:gate_evidence",
            "schemaDefinition": {
              "type": "object",
              "properties": {
                "policy": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                }
              },
              "required": [
                "policy",
                "passed"
              ],
              "additionalProperties": false
            }
          }
        },
        "gate": {
          "policy": "workflow-condition",
          "condition": {
            "op": "eq",
            "args": [
              {
                "ref": "input.condition"
              },
              {
                "literal": true
              }
            ]
