{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "skipLibCheck": false,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "../../plugins/builtin-resources/src/**/*.ts", "../../plugins/builtin-nodes/src/**/*.ts", "../../plugins/provider-codex/src/**/*.ts"]
}
